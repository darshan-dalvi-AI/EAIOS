# ── EAIOS configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every value has a safe default; the app
# runs with zero external services (SQLite + in-memory vectors + mock LLM).

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — leave unset for SQLite dev fallback (./eaios.db)
# DATABASE_URL=postgresql+psycopg2://eaios:eaios_dev_password@localhost:5432/eaios

# Vector store — leave unset for in-memory fallback
# QDRANT_URL=http://localhost:6333

# Redis (rate limiting / task queue) — optional
# REDIS_URL=redis://localhost:6379/0

# ── LLM layer ────────────────────────────────────────────────────
# mock | ollama | openai | anthropic  (openai = any OpenAI-compatible endpoint)
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OpenRouter = ONE key for GPT, Claude, Gemini, DeepSeek, Qwen, Llama, Phi.
# Get a key at https://openrouter.ai/keys and set:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free   ($0 tier; switch live in Settings → AI Model)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TEMPERATURE=0.3

# ── Embeddings: hash (zero-dep dev) | ollama | sentence-transformers
EMBEDDING_PROVIDER=auto
EMBEDDING_DIM=384

# ── Agent routing: auto (LLM semantic router when a real model is available,
#    regex otherwise) | llm | regex. LLM routing fans tasks out in parallel.
ROUTER_MODE=auto

# ── Graph checkpointer: persist orchestrator state to the DB after every
#    super-step (keyed by conversation) so interrupted runs resume exactly
#    where they stopped. LangGraph checkpointer semantics.
GRAPH_CHECKPOINTS=true

# ── Scheduled workflows: background loop that fires trigger=schedule
#    automations when their per-workflow interval elapses.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=60

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads

# ── Observability (optional) ─────────────────────────────────────
# Traces are always available in the Traces app (in-process buffer).
# Mirror them to external dashboards by configuring either exporter:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # + pip install opentelemetry-sdk opentelemetry-exporter-otlp
# LANGFUSE_PUBLIC_KEY=pk-...                          # + pip install langfuse
# LANGFUSE_SECRET_KEY=sk-...

# Platform owner(s): comma-separated emails that unlock the Workspaces
# console (list / suspend / delete any company workspace). Blank = disabled.
PLATFORM_OWNER_EMAILS=

# ── Production hardening ─────────────────────────────────────────────
# Set to "production" to enable fail-closed checks: the app refuses to boot
# with the default SECRET_KEY, and the API docs (/docs, /openapi.json) are
# switched off so the schema is not published.
ENVIRONMENT=development

# Rate limits — 0 keeps the built-in default. Auth routes are limited per IP
# AND per targeted account, with exponential backoff instead of a lockout
# (a lockout would let anyone who knows an email lock the owner out).
RL_LOGIN_CAPACITY=0        # default 10 per 60s
RL_LOGIN_WINDOW=0
RL_SIGNUP_CAPACITY=0       # default 5 per hour
RL_SIGNUP_WINDOW=0
RL_UPLOAD_CAPACITY=0       # default 40 per hour
RL_CHAT_CAPACITY=0         # default 60 per 60s
RL_SEARCH_CAPACITY=0       # default 120 per 60s

# Uploads: refused while streaming once the cap is exceeded, so an oversized
# body can never fill the disk.
MAX_UPLOAD_MB=25

# Show raw database errors in SQL Studio (they describe the schema).
SQL_SHOW_DB_ERRORS=false

# HTTP security headers are always on (CSP, X-Frame-Options, nosniff,
# Referrer-Policy, Permissions-Policy). HSTS is added only when
# ENVIRONMENT=production, since pinning HTTPS on localhost breaks dev.

# AI cost controls
LLM_MAX_TOKENS=1500              # ceiling on every generation
LLM_DAILY_TOKEN_BUDGET=200000    # rolling 24h per user; 0 disables

# ── Proving people own the address they sign up with ──────────────────────
# Two ways in, both of which end with a verified address:
#   1. Sign in with Google — Google has already checked, so no code is sent.
#   2. A six-digit code, hashed before storage, valid 15 minutes, 6 tries.
#
# REQUIRE_EMAIL_VERIFICATION follows delivery when left unset: with no
# provider below, codes would only reach the server log, so demanding one
# would lock every new signup out of the workspace it just created. Set it
# to 1 to insist regardless, or 0 to waive it.
REQUIRE_EMAIL_VERIFICATION=
RESEND_API_KEY=                  # https://resend.com — simplest option
MAIL_FROM=                       # e.g. EAIOS <noreply@yourdomain.com>
# ...or plain SMTP instead of Resend:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google sign-in. Create an OAuth client (type: Web application) at
# console.cloud.google.com/apis/credentials, add your site as an authorised
# JavaScript origin, and paste the client ID here. The server re-verifies
# every token with Google, so a forged one is useless.
GOOGLE_CLIENT_ID=

# ── Plans and limits ──────────────────────────────────────────────────────
# Which plan a brand-new workspace starts on: free | pro | business.
# "free" gives the SaaS experience — real limits on documents, seats, custom
# agents and running automations, with an upgrade prompt at the point of
# refusal. A self-hosted deployment has no billing relationship, so set
# DEFAULT_PLAN=business and no limit ever applies.
# Limits are defined in backend/app/services/plans.py; changing a workspace's
# plan is an admin action (Settings → Plan & usage), audited like any other.
DEFAULT_PLAN=free
